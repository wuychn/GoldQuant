# GoldQuant 环境变量模板。复制为 .env 后按需修改。
# 前缀均为 GOLDQUANT_（LLM_* / FEISHU_* 支持无前缀写法）。
# 业务/策略参数见 quant/config/quant.yml；完整说明见 docs/CONFIG.md。

# ─── 应用元信息 ───
GOLDQUANT_ENV=local               # 运行环境标识（仅 / 根路径展示用）
GOLDQUANT_API_V1_STR=/api/v1      # API 路由前缀

# ─── Uvicorn 启动（python -m app）───
GOLDQUANT_HOST=0.0.0.0
GOLDQUANT_PORT=8085               # API 端口
GOLDQUANT_UVICORN_RELOAD=true     # 热重载；生产设 false

# ─── CORS ───
GOLDQUANT_CORS_ORIGINS=*          # 单个 * 或逗号分隔多源
GOLDQUANT_CORS_ALLOW_CREDENTIALS=false  # ORIGINS=* 时强制 false

# ─── HTTP 客户端（同花顺等直连）───
GOLDQUANT_HTTP_CLIENT_TIMEOUT=30
GOLDQUANT_THS_DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ─── 出站代理（AKShare / 同花顺 / httpx 均走此）───
GOLDQUANT_PROXY_ENABLED=false
GOLDQUANT_PROXY_URL=              # 例 http://127.0.0.1:7890
# GOLDQUANT_PROXY_HTTP_URL=        # HTTP/HTTPS 分别覆盖（留空回退 PROXY_URL）
# GOLDQUANT_PROXY_HTTPS_URL=
GOLDQUANT_PROXY_NO_PROXY=localhost,127.0.0.1

# ─── 量化运行时目录（state / views / daily / config / memory / cache 均在其下）───
# 未设置时默认 ~/.quant；shell 也可 export QUANT_HOME=... 临时覆盖（优先级低于此项）
GOLDQUANT_QUANT_HOME_DIR=

# ─── 历史日线拉取 ───
GOLDQUANT_QUANT_HIST_FULL_START_DATE=19900101  # 本地尚无日线时全量起始日（YYYYMMDD）
GOLDQUANT_QUANT_HIST_INCREMENTAL_TRADE_DAYS=5 # 末根已是今天时向前重叠拉取的交易日数
GOLDQUANT_QUANT_SPOT_EM_FULL_TABLE=false      # 盘前是否拉全市场 spot_em 表（数据大、易限流）
GOLDQUANT_QUANT_HIST_RESPONSE_MAX_BARS=48     # 接口「历史行情」日线返回条数上限
GOLDQUANT_QUANT_HIST_SCORING_MAX_BARS=90      # 候选 enrich 历史行情保留交易日数

# ─── Enrich 并发（每只含盘口/日K/分钟/资金流，过大易触发源站限流）───
GOLDQUANT_QUANT_ENRICH_CONCURRENCY=6
# 晚间复盘 enrich：批内并发 / 每批只数 / 批间暂停
GOLDQUANT_QUANT_ENRICH_EVENING_CONCURRENCY=6
GOLDQUANT_QUANT_ENRICH_EVENING_BATCH_SIZE=20
GOLDQUANT_QUANT_ENRICH_EVENING_BATCH_PAUSE_SEC=600

# ─── 同花顺个股实时资金流（缓存 / 重试 / 累计失败退避）───
GOLDQUANT_QUANT_THS_FUNDS_CACHE_TTL_SEC=120
GOLDQUANT_QUANT_THS_FUNDS_RETRY_MAX=3
GOLDQUANT_QUANT_THS_FUNDS_RETRY_BASE_SEC=1
GOLDQUANT_QUANT_THS_FUNDS_FAILURE_BACKOFF_SEC=5

# ─── 测试阶段 ───
GOLDQUANT_QUANT_TEST_PHASE=false         # true 时 API/enrich/推送/state 列表统一仅 3 条
GOLDQUANT_QUANT_USE_LOCAL_FIXTURE=false  # true 时 python -m quant 读 data/*.json，不调 service

# ─── 飞书推送（quant 机器人）───
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ID=

# ─── LLM（新闻解读 / 复盘叙述）───
# 优先 LLM_*（无前缀）；兼容 GOLDQUANT_LLM_*
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M2.7
GOLDQUANT_LLM_API_FORMAT=openai   # openai → /chat/completions；anthropic → /v1/messages
GOLDQUANT_LLM_VERIFY_SSL=false    # 内网/自签证书网关设 false
GOLDQUANT_LLM_TRUST_ENV_PROXY=false  # 避免系统 HTTP_PROXY 干扰 LLM 出站
