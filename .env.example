# 复制为 `.env` 后按需修改（环境变量前缀均为 GOLDQUANT_）

# 运行环境标识（仅用于 / 根路径展示等）
GOLDQUANT_ENV=local

# API 版本前缀
GOLDQUANT_API_V1_STR=/api/v1

# 开发启动（python -m app / run.ps1 / run.sh）时的监听地址与端口（已固定读取「项目根目录」下的 .env）
GOLDQUANT_HOST=0.0.0.0
GOLDQUANT_PORT=8085
# 若使用裸命令 `uvicorn app.main:app` 且未写 --port，监听端口由 Uvicorn 默认 8085 决定，不会读此项；请改用 python -m app，或：uvicorn app.main:app --port 8085
# 是否启用热重载（生产环境可设为 false，并用 uvicorn 命令行不带 reload）
GOLDQUANT_UVICORN_RELOAD=true

# CORS：单个 `*` 或逗号分隔多个源，如 http://localhost:3000,https://app.example.com
GOLDQUANT_CORS_ORIGINS=*
# 是否允许携带 Cookie（当 CORS_ORIGINS 为 `*` 时内部会强制为 false）
GOLDQUANT_CORS_ALLOW_CREDENTIALS=false

# 同花顺等 HTTP 请求超时（秒）
GOLDQUANT_HTTP_CLIENT_TIMEOUT=30

# 访问同花顺时使用的 User-Agent（部分环境需模拟浏览器）
GOLDQUANT_THS_DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# 出站代理（AKShare / 同花顺 httpx 等全部走此配置；关闭时勿写 true 或保持 false）
GOLDQUANT_PROXY_ENABLED=false
# 示例：本地 Clash / V2：http://127.0.0.1:7890
GOLDQUANT_PROXY_URL=
# 若 HTTP 与 HTTPS 需不同代理，可分别覆盖（留空则回退到 PROXY_URL）
# GOLDQUANT_PROXY_HTTP_URL=
# GOLDQUANT_PROXY_HTTPS_URL=
GOLDQUANT_PROXY_NO_PROXY=localhost,127.0.0.1

# 测试阶段：true 时 API/enrich/推送/state 等列表统一仅 3 条
GOLDQUANT_QUANT_TEST_PHASE=false

# 本地数据：true 时 python -m quant 从 data/*.json 读数，不请求 FastAPI
GOLDQUANT_QUANT_USE_LOCAL_FIXTURE=false

# 盘中/盘后自选 enrich 并发数（默认 6；过大易触发东财/同花顺限流）
# GOLDQUANT_QUANT_ENRICH_CONCURRENCY=6

# 晚间复盘 enrich：批内并发 6、每批 20 只、批间等待 600 秒（10 分钟）
# GOLDQUANT_QUANT_ENRICH_EVENING_CONCURRENCY=6
# GOLDQUANT_QUANT_ENRICH_EVENING_BATCH_SIZE=20
# GOLDQUANT_QUANT_ENRICH_EVENING_BATCH_PAUSE_SEC=600

# 同花顺个股实时资金流：缓存 TTL / 重试 / 累计失败退避（秒）
# GOLDQUANT_QUANT_THS_FUNDS_CACHE_TTL_SEC=120
# GOLDQUANT_QUANT_THS_FUNDS_RETRY_MAX=3
# GOLDQUANT_QUANT_THS_FUNDS_RETRY_BASE_SEC=1
# GOLDQUANT_QUANT_THS_FUNDS_FAILURE_BACKOFF_SEC=5

# 飞书推送（quant 机器人）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ID=

# 全局 LLM：优先 LLM_*（无前缀）；兼容 GOLDQUANT_LLM_*
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M2.7
# openai → /chat/completions；anthropic → /v1/messages
GOLDQUANT_LLM_API_FORMAT=openai
# 内网/自签证书网关：不校验 HTTPS 证书
GOLDQUANT_LLM_VERIFY_SSL=false
# 避免系统 HTTP_PROXY 干扰 LLM 出站
GOLDQUANT_LLM_TRUST_ENV_PROXY=false
